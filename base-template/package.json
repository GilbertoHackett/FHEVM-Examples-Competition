  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@typechain/ethers-v5": "^11.0.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.3.1",
    "chai": "^4.3.7",
    "eslint": "^8.41.0",
    "ethers": "^5.7.2",
    "hardhat": "^2.19.0",
    "hardhat-fhevmjs": "^0.4.0",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.1",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@fhevm/solidity": "0.9.0",
    "dotenv": "^16.3.1"
  }
}
